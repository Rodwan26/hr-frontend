# Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# ===========================================
# API Configuration
# ===========================================

# Backend API URL
# Development: http://localhost:8000
# Production: Your Render backend URL (e.g., https://hr-ai-platform-backend.onrender.com)
NEXT_PUBLIC_API_URL=https://hr-ai-platform-backend.onrender.com

# ===========================================
# Application Environment
# ===========================================

# Set to 'production' for production builds
NODE_ENV=development

# Vercel deployment flag (automatically set by Vercel)
# VERCEL=true
